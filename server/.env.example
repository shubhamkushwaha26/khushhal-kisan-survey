# Copy this file to server/.env and fill in your private values.
# Local development: use your local PostgreSQL connection string.
# Production: set the Neon connection string in your hosting provider's environment settings.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require
PORT=5000
CLIENT_ORIGIN=http://localhost:5173,http://localhost:5174
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=PASTE_BCRYPT_HASH_HERE
JWT_SECRET=GENERATE_A_LONG_RANDOM_SECRET_HERE
